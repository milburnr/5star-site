  "content_rules": {
    "stat_bars": "omit — never fabricated, remove if no verified data in client.json",
    "hero_text": "complete sentences only, no em-dashes, no three-item triplets",
    "images": "real job photos only on hero and hub pages",
    "map": "city must match page location — never hardcode",
    "display_type_on_photo": "semi-transparent, never solid fill — opacity 0.56 default",
    "display_type_semantic_role": "decorative ONLY (aria-hidden). Real H1 lives in content section below.",
    "cta_per_page": "one primary CTA only",
    "cost_claims": "no specific costs unless in pricing_reference_guide",
    "stat_claims": "no project counts, satisfaction rates, or response times unless in client.json",
    "fake_brand_seals": "never. The 5 Star logo is the only brand mark. No medallions claiming 'Texas Built Texas Proud' or similar fabricated taglines.",
    "fake_taglines": "tagline must exist in client.json before it appears on screen"
  },
  "scaling_strategy": {
    "viewport_targets": [
      { "width": 1280, "note": "smaller laptop — clamp lower bounds engaged" },
      { "width": 1440, "note": "primary desktop reference" },
      { "width": 1920, "note": "HD desktop" },
      { "width": 2560, "note": "wide HD / QHD" },
      { "width": 3840, "note": "4K — uncapped vw-driven scaling" }
    ],
    "approach": "All hero typography uses clamp(min, preferred-vw-driven, max-vw) rather than rem-capped maxes. Result: WEST TEXAS scales from ~96px at 1280 to ~720px at 4K, proportional across the full range.",
    "overflow_x": "html, body have overflow-x: hidden when alt-home-hero is present, preventing any horizontal scrollbar from rounding errors at extreme widths."
  },
  "chat_widget_behavior": {
    "load_trigger": "defers until user scroll, click, or touchstart (no auto-load timeout)",
    "implementation": "ChatWidget.tsx — 5s setTimeout fallback was removed in this session",
    "reason": "previous 5s auto-load was loading the widget on hero-only preview pages where users never scrolled; defer-until-interaction is the cleaner UX and matches Rich's directive"
  }

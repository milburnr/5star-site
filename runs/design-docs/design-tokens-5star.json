    "reduced_motion": "all keyframe animations are disabled; final visual state preserved",
    "deferred_for_phase_4_followup": [
      "Hero photo subtle parallax drift on scroll (5-10px)",
      "Side rail scroll-parallax: reverse entry slide as user scrolls down (CSS animation-timeline: scroll())"
    ]
  },

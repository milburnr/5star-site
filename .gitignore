# Images (served from R2, not git)
processed-images/
processed-categories/
processed-heroes/
public/images/jobs/
*.jpg
*.jpeg
*.png
*.webp
*.avif
# Phase 12 Stream C: trust-signal logos shipped in-repo (not R2)
!public/images/trust/**/*.png
!public/images/trust/**/*.svg
!public/images/trust/**/*.jpg
!public/images/trust/**/*.webp
# Homepage hero — same-origin WebP (preloaded, ~55-395K per variant)
# Kept in repo so CI deploys them (CSS in globals.css points at /images/home-hero-*.webp)
!public/images/home-hero-*.webp
# Editorial hero (AltHeroFrame / HomeHero) — same-origin AVIF + WebP at 4 widths.
# Optimized from the source 2.5MB PNG via scripts/optimize-hero.mjs.
# Mobile ships ~46KB WebP / ~39KB AVIF. Desktop 1920w ~271KB WebP / ~199KB AVIF.
!public/images/heroes/5star-new-hero-*.webp
!public/images/heroes/5star-new-hero-*.avif
# Curated card photography (material/process/service hero shots) — same-origin
!public/images/materials/**/*.webp
!public/images/materials/**/*.png
!public/images/materials/**/*.jpg
!public/images/process/**/*.webp
!public/images/services/**/*.webp
# Content-ops: pricing reference images embedded in blog articles
!public/assets/**/*.png
!public/assets/**/*.jpg
!public/assets/**/*.jpeg
!public/assets/**/*.webp
